# ── LLM ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── LangSmith tracing ────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=neuradesk-dev

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://neuradesk:neuradesk@localhost:5432/neuradesk

# ── Mock enterprise API ───────────────────────────────────────────────
# Used as Bearer token for all /itsm and /hr endpoints.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENTERPRISE_API_SECRET=change-me-before-running

# ── Mock enterprise API base URL (for the action node client) ─────────
ENTERPRISE_API_BASE_URL=http://localhost:8001

# ── FastAPI backend ───────────────────────────────────────────────────
API_SECRET_KEY=change-me-before-running
