# NeuraDesk — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
#
# Required for all environments:
# ─────────────────────────────────────────────────────────────────────────────

# LLM provider — used by all agents and DSPy classifier
# Get a free key at https://console.groq.com/
GROQ_API_KEY=gsk_...

# Shared bearer token for the mock enterprise API (port 8001)
# Any non-empty string works for local dev; use a strong random value in prod
ENTERPRISE_API_SECRET=change-me-in-production

# JWT signing key — must be at least 32 random characters in production
# Generate: openssl rand -hex 32
API_SECRET_KEY=dev-insecure-key-change-me

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────

# Omit to fall back to SQLite (neuradesk.db) — fine for local dev without Docker
# Docker Compose sets this automatically via environment: block in docker-compose.yml
# DATABASE_URL=postgresql://neuradesk:neuradesk@localhost:5432/neuradesk

# ─────────────────────────────────────────────────────────────────────────────
# Optional — LangSmith tracing
# ─────────────────────────────────────────────────────────────────────────────

# Create a project at https://smith.langchain.com/ and paste the key below.
# If omitted, tracing is silently disabled; all other features still work.
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=neuradesk

# ─────────────────────────────────────────────────────────────────────────────
# Optional — Anthropic (vision fallback only)
# ─────────────────────────────────────────────────────────────────────────────

# Only needed if you submit image-channel tickets in local dev.
# Cloud Run uses GROQ for vision; set this only if you want Claude vision locally.
# ANTHROPIC_API_KEY=sk-ant-...
