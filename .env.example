# ── Application ──────────────────────────────────────────────────────
APP_ENV=development
API_SECRET_KEY=
ORG_CREATION_SECRET=

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://neuradesk:neuradesk@localhost:5432/neuradesk
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── LLM ──────────────────────────────────────────────────────────────
# LLM_PROVIDER controls which backend all agents use (groq | anthropic | openai)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── LangSmith tracing ────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=neuradesk-dev

# ── Mock enterprise API ───────────────────────────────────────────────
ENTERPRISE_API_BASE_URL=http://localhost:8001
ENTERPRISE_API_SECRET=local-dev-secret-123

# ── SMTP (OTP emails) ─────────────────────────────────────────────────
# Leave blank in dev — OTP is returned in the API response instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@neuradesk.ai
SUPPORT_EMAIL=support@neuradesk.ai

# ── A2A protocol ──────────────────────────────────────────────────────
# Required — server refuses to start if unset. Use a long random secret.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
A2A_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────
# localhost:5173 is always added in development; add prod domain here.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
